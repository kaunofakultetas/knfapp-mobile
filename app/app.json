{
  "expo": {
    "name": "VU KNF",
    "slug": "KNFAPP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "knfapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "lt": "./locales/lt.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lt.vu.knf.knfapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "lt.vu.knf.knfapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#151215"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera reikalinga kvietimo QR kodams nuskaityti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Prieiga prie nuotraukų reikalinga dalintis vaizdais įrašuose ir žinutėse."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B003F"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "047e5a37-c245-4719-83cd-af6bbef2ebb7"
      }
    }
  }
}
