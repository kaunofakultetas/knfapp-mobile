{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@knf/chatuikit": ["./packages/chatuikit/src"],
      "@knf/chatuikit/*": ["./packages/chatuikit/src/*"],
      "@knf/chatengine": ["./packages/chatengine/src"],
      "@knf/chatengine/*": ["./packages/chatengine/src/*"],
      "@knf/timetableengine": ["./packages/timetableengine/src"],
      "@knf/timetableengine/*": ["./packages/timetableengine/src/*"],
      "@knf/timetableuikit": ["./packages/timetableuikit/src"],
      "@knf/timetableuikit/*": ["./packages/timetableuikit/src/*"],
      "@knf/dataengine": ["./packages/dataengine/src"],
      "@knf/dataengine/*": ["./packages/dataengine/src/*"],
      "@knf/socialengine": ["./packages/socialengine/src"],
      "@knf/socialengine/*": ["./packages/socialengine/src/*"],
      "@knf/socialuikit": ["./packages/socialuikit/src"],
      "@knf/socialuikit/*": ["./packages/socialuikit/src/*"],
      "@knf/wayfindengine": ["./packages/wayfindengine/src"],
      "@knf/wayfindengine/*": ["./packages/wayfindengine/src/*"],
      "@knf/wayfinduikit": ["./packages/wayfinduikit/src"],
      "@knf/wayfinduikit/*": ["./packages/wayfinduikit/src/*"],
      "@knf/wayfindeditor": ["./packages/wayfindeditor/src"],
      "@knf/wayfindeditor/*": ["./packages/wayfindeditor/src/*"],
      "@knf/wayfindsync": ["./packages/wayfindsync/src"],
      "@knf/wayfindsync/*": ["./packages/wayfindsync/src/*"],
      "@knf/wayfindcapture": ["./packages/wayfindcapture/src"],
      "@knf/wayfindcapture/*": ["./packages/wayfindcapture/src/*"],
      "@knf/notifyengine": ["./packages/notifyengine/src"],
      "@knf/notifyengine/*": ["./packages/notifyengine/src/*"],
      "@knf/notifyuikit": ["./packages/notifyuikit/src"],
      "@knf/notifyuikit/*": ["./packages/notifyuikit/src/*"],
      "@/*": ["./*"],
      "@/appScreens/*": ["./appScreens/*"],
      "@/assets/*": ["./assets/*"],
      "@/components/*": ["./components/*"],
      "@/constants/*": ["./constants/*"],
      "@/context/*": ["./context/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/types": ["./types/index"],
      "@/types/*": ["./types/*"],
      "@/utils/*": ["./utils/*"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
